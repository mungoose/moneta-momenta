# Fail installs on an unsupported Node version instead of only warning
# (package.json "engines": node >= 24; Vercel and CI use 24).
engine-strict=true

# Record exact versions for newly added dependencies, so package.json says
# what's actually installed. The lockfile still pins transitive deps.
save-exact=true

# Keep install output short (useful for humans and for Claude Code's context).
fund=false

# Never commit auth tokens here; use environment variables or ~/.npmrc.
